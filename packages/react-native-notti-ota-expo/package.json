{
  "name": "react-native-notti-ota-expo",
  "version": "0.1.0",
  "description": "Expo adapter for Notti Live updates: loads the selected bundle through Expo's supported hooks",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "expo-module.config.json",
    "*.podspec",
    "!android/build",
    "!android/src/test",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "expo",
    "live-updates",
    "ota",
    "notti"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeplabs/zeep-notti-react-native-ota.git",
    "directory": "packages/react-native-notti-ota-expo"
  },
  "author": "Zeep Tecnologia <opensource@zeeplabs.com.br> (https://github.com/zeeplabs)",
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react-native-notti-ota": "^0.1.0"
  },
  "devDependencies": {
    "react-native-notti-ota": "workspace:*"
  },
  "homepage": "https://github.com/zeeplabs/zeep-notti-react-native-ota/tree/main/packages/react-native-notti-ota-expo#readme",
  "bugs": {
    "url": "https://github.com/zeeplabs/zeep-notti-react-native-ota/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "del-cli lib && bob build",
    "clean": "del-cli lib"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
