{
  "name": "react-native-notti-ota",
  "version": "0.1.0",
  "description": "Notti Live updates for React Native: signed JS bundle updates with automatic rollback",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./lib/module/index.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "!ios/generated",
    "!android/generated",
    "!ios/build",
    "!ios/Tests",
    "!android/build",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android",
    "live-updates",
    "ota",
    "notti"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeplabs/zeep-notti-react-native-ota.git",
    "directory": "packages/react-native-notti-ota"
  },
  "author": "Zeep Tecnologia <opensource@zeeplabs.com.br> (https://github.com/zeeplabs)",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.83.0",
    "@expo/config-plugins": "*"
  },
  "codegenConfig": {
    "name": "NottiOtaSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.notti.ota"
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^55.0.12",
    "@types/node": "^22.20.7"
  },
  "scripts": {
    "build": "del-cli lib plugin/build && bob build && tsc -p plugin/tsconfig.json",
    "build:plugin": "tsc -p plugin/tsconfig.json",
    "clean": "del-cli lib plugin/build"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "homepage": "https://github.com/zeeplabs/zeep-notti-react-native-ota/tree/main/packages/react-native-notti-ota#readme",
  "bugs": {
    "url": "https://github.com/zeeplabs/zeep-notti-react-native-ota/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
