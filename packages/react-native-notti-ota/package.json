{
  "name": "react-native-notti-ota",
  "version": "0.1.0",
  "description": "Notti Live updates for React Native: signed JS bundle updates with automatic rollback",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "!ios/generated",
    "!android/generated",
    "!ios/build",
    "!ios/Tests",
    "!android/build",
    "!android/src/test",
    "!**/__tests__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "ios",
    "android",
    "live-updates",
    "ota",
    "notti"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeplabs/zeep-notti-react-native-ota.git",
    "directory": "packages/react-native-notti-ota"
  },
  "author": "Zeep Tecnologia <opensource@zeeplabs.com.br> (https://github.com/zeeplabs)",
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.83.0",
    "@expo/config-plugins": "*"
  },
  "codegenConfig": {
    "name": "NottiOtaSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.notti.ota"
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "^55.0.12",
    "@types/node": "^22.20.7"
  },
  "scripts": {
    "build:plugin": "tsc -p plugin/tsconfig.json"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "homepage": "https://github.com/zeeplabs/zeep-notti-react-native-ota/tree/main/packages/react-native-notti-ota#readme",
  "bugs": {
    "url": "https://github.com/zeeplabs/zeep-notti-react-native-ota/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
